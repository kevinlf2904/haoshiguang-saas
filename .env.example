NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only set on trusted server environments. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Public application domain used by the storefront.
NEXT_PUBLIC_APP_DOMAIN=haoshiguang.tw

# One-time first-owner setup. Use a separate random secret (32+ bytes) and the
# exact UUID of the Pilot tenant. Remove both values after successful bootstrap.
PILOT_OWNER_BOOTSTRAP_TENANT_ID=
PILOT_OWNER_BOOTSTRAP_SECRET=

# Required for checkout and customer order-tracking links.
# Replace the placeholder with at least 32 cryptographically random bytes.
# Keep previous key versions while previously issued tracking links must remain valid.
ORDER_TRACKING_HMAC_KEYS='{"1":"REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"}'
ORDER_TRACKING_HMAC_ACTIVE_KEY_VERSION=1

# Required by the scheduled retention endpoint when Vercel Cron is enabled.
# Generate a separate high-entropy value; do not reuse an HMAC or Supabase key.
CRON_SECRET=REPLACE_WITH_A_SEPARATE_HIGH_ENTROPY_SECRET
